# Read-only and DRAFT_ONLY Meta Marketing API configuration.
# Never commit real tokens or copy another product's credentials.
META_GRAPH_API_VERSION=v25.0
META_MARKETING_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ACTOR_ID=
META_PIXEL_ID=

# Optional known prior campaign ID used only to detect an already-active Jingeehas campaign.
META_EXISTING_JINGEEHAS_CAMPAIGN_ID=

# Execution acknowledgements. The builder blocks without every field below.
META_PRODUCT_CODE=WEIGHT_TEST_ONE_TIME
META_SHARED_ACCOUNT_ACK=
META_AUDIO_RIGHTS_CONFIRMED=false
META_MONTHLY_CAP_USD=
META_APPROVAL_FINGERPRINT=

# Tracking remains separately disabled until Test Events and deduplication pass.
META_CAPI_ENABLED=false
META_BROWSER_PIXEL_ENABLED=false
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
